  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Receipt": {
        "properties": {
          "warehouse_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Warehouse Id"
          },
          "sku_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Sku Id"
          },
          "expected_version": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "source": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Source"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "title": "Note",
            "default": ""
          },
          "g": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "G"
          },
          "q": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Q",
            "default": 0
          },
          "d": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "D",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "warehouse_id",
          "sku_id",
          "expected_version",
          "source",
          "g"
        ],
        "title": "Receipt"
      },
      "SKU": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Code"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "spec": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Spec"
          },
          "unit": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Unit",
            "default": "件"
          },
          "barcode": {
            "type": "string",
            "maxLength": 120,
            "title": "Barcode",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "name",
          "spec"
        ],
        "title": "SKU"
      },
      "Sale": {
        "properties": {
          "warehouse_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Warehouse Id"
          },
          "sku_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Sku Id"
          },
          "expected_version": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "source": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Source"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
