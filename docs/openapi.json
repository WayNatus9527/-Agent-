  "components": {
    "schemas": {
      "Adjustment": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "adjustment",
            "title": "Kind"
          },
          "warehouse_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Warehouse Id"
          },
          "sku_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Sku Id"
          },
          "expected_version": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "delta": {
            "$ref": "#/components/schemas/Delta"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "warehouse_id",
          "sku_id",
          "expected_version",
          "delta",
          "reason"
        ],
        "title": "Adjustment"
      },
      "Close": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "reason"
        ],
        "title": "Close"
      },
      "Delta": {
        "properties": {
          "g": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "G",
            "default": 0
          },
          "q": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Q",
            "default": 0
          },
          "d": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "D",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Delta"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportPreview": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "skus",
              "warehouses",
              "opening"
            ],
            "title": "Kind"
          },
          "csv_text": {
            "type": "string",
            "maxLength": 1000000,
            "minLength": 1,
            "title": "Csv Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "csv_text"
        ],
        "title": "ImportPreview"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Purchase": {
        "properties": {
          "warehouse_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Warehouse Id"
          },
          "code": {
